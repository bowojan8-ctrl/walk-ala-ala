--==================================================--
-- FILE HELPERS
--==================================================--

local function ensureConfigFolder()

    if not FileAPIAvailable then
        return false, "writefile/readfile tidak tersedia"
    end

    if type(isfolder) == "function" then

        local exists = false

        pcall(function()
            exists = isfolder(CONFIG_FOLDER)
        end)

        if exists then
            return true
        end

    end

    if FolderAPIAvailable then

        local success, err =
            pcall(function()
                makefolder(CONFIG_FOLDER)
            end)

        if success then
            return true
        end

        return false, tostring(err)

    end

    return false, "makefolder/isfolder tidak tersedia"
end

local function sanitizeConfigName(name)

    name = tostring(name or "")

    name = string.gsub(
        name,
        "[\\/:*?\"<>|]",
        "_"
    )

    name = string.gsub(
        name,
        "^%s+",
        ""
    )

    name = string.gsub(
        name,
        "%s+$",
        ""
    )

    name = string.gsub(
        name,
        "%.tas$",
        ""
    )

    if name == "" then
        name = "CP_" .. tostring(os.time())
    end

    return name
end

local function getConfigPath(name)

    return CONFIG_FOLDER ..
        "/" ..
        sanitizeConfigName(name) ..
        ".tas"

end

--==================================================--
-- SERIALIZE / DESERIALIZE
--==================================================--

local function serializeFrame(frame)

    if not frame
        or not frame.position then

        return nil
    end

    local p = frame.position

    return {
        position = {
            x = tonumber(p.X) or 0,
            y = tonumber(p.Y) or 0,
            z = tonumber(p.Z) or 0
        },

        jump = frame.jump == true,

        time = tonumber(frame.time) or 0
    }

end

local function serializeConfig(config)

    local output = {}

    for i, frame in ipairs(config or {}) do

        local serialized =
            serializeFrame(frame)

        if serialized then
            output[i] = serialized
        end

    end

    return {
        version = 2,
        fps = 1 / RECORD_RATE,
        frames = output
    }

end

local function normalizeFrame(frame)

    if not frame then
        return nil
    end

    local p =
        frame.position
        or frame.pos

    if type(p) ~= "table" then
        return nil
    end

    -- Format baru: x/y/z
    local x =
        tonumber(
            p.x
            or p.X
            or 0
        )

    local y =
        tonumber(
            p.y
            or p.Y
            or 0
        )

    local z =
        tonumber(
            p.z
            or p.Z
            or 0
        )

    return {

        position =
            Vector3.new(
                x,
                y,
                z
            ),

        jump =
            frame.jump == true,

        time =
            tonumber(
                frame.time
            ) or 0

    }

end

local function deserializeConfig(data)

    if type(data) ~= "table" then
        return nil
    end

    local rawFrames = data.frames

    -- Dukungan config lama yang langsung berupa array.
    if type(rawFrames) ~= "table" then

        if #data > 0 then
            rawFrames = data
        else
            return nil
        end

    end

    local output = {}

    for i, rawFrame in ipairs(rawFrames) do

        local frame =
            normalizeFrame(rawFrame)

        if frame then
            output[#output + 1] = frame
        end

    end

    if #output < 1 then
        return nil
    end

    return output
end

--==================================================--
-- SAVE ONE CONFIG
--==================================================--

local function saveConfigFile(name, config)

    local folderOK, folderErr =
        ensureConfigFolder()

    if not folderOK then

        warn(
            "BALJITOT: folder config gagal:",
            folderErr
        )

        return false
    end

    local path =
        getConfigPath(name)

    local payload =
        serializeConfig(config)

    local success, err =
        pcall(function()

            writefile(
                path,
                HttpService:JSONEncode(
                    payload
                )
            )

        end)

    if not success then

        warn(
            "BALJITOT: gagal save config:",
            err
        )

        return false
    end

    return true
end

--==================================================--
-- LOAD ONE CONFIG
--==================================================--

local function loadConfigFile(name)

    if not FileAPIAvailable then
        return nil
    end

    local folderOK =
        ensureConfigFolder()

    if not folderOK then
        return nil
    end

    local path =
        getConfigPath(name)

    if type(isfile) == "function" then

        local exists = false

        pcall(function()
            exists = isfile(path)
        end)

        if not exists then
            return nil
        end

    end

    local success, data =
        pcall(function()

            return HttpService:JSONDecode(
                readfile(path)
            )

        end)

    if not success then

        warn(
            "BALJITOT: gagal membaca [" ..
            tostring(name) ..
            "]"
        )

        return nil
    end

    return deserializeConfig(data)
end

--==================================================--
-- REFRESH CONFIGS FROM FOLDER
--==================================================--

local function loadConfigsFromFolder()

    Configs = {}

    local folderOK, folderErr =
        ensureConfigFolder()

    if not folderOK then

        warn(
            "BALJITOT: config folder tidak tersedia:",
            folderErr
        )

        return false
    end

    if not ListAPIAvailable then

        warn(
            "BALJITOT: listfiles tidak tersedia di executor."
        )

        return false
    end

    local success, files =
        pcall(function()

            return listfiles(
                CONFIG_FOLDER
            )

        end)

    if not success
        or type(files) ~= "table" then

        warn(
            "BALJITOT: gagal membaca isi folder config."
        )

        return false
    end

    for _, fullPath in ipairs(files) do

        local path =
            tostring(fullPath)

        local fileName =
            path:match(
                "([^/\\]+)$"
            )

        if fileName
            and fileName:lower():match(
                "%.tas$"
            ) then

            local name =
                fileName:sub(
                    1,
                    -5
                )

            local config =
                loadConfigFile(name)

            if config then
                Configs[name] = config
            end

        end

    end

    return true
end

-- Load all configs saat start.
loadConfigsFromFolder()

