-- REFRESH CONFIG LIST
--==================================================--

local refreshConfigList

refreshConfigList =
    function()

        for _, child in
            ipairs(
                ConfigList:GetChildren()
            ) do

            if child:IsA(
                "TextButton"
            )
            or child:IsA(
                "TextLabel"
            ) then

                child:Destroy()

            end

        end

        if next(Configs) == nil then

            selectedConfig = nil

            local Empty =
                Instance.new(
                    "TextLabel"
                )

            Empty.Parent =
                ConfigList

            Empty.BackgroundTransparency = 1

            Empty.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    30
                )

            Empty.Font =
                Enum.Font.Gotham

            Empty.Text =
                "Belum ada config"

            Empty.TextColor3 =
                Color3.fromRGB(
                    130,
                    130,
                    130
                )

            Empty.TextSize = 11

            return
        end

        if selectedConfig
            and not Configs[selectedConfig] then

            selectedConfig = nil

        end

        local names = {}

        for name in pairs(Configs) do

            table.insert(
                names,
                name
            )

        end

        table.sort(
            names,
            function(a, b)

                return string.lower(a)
                    <
                    string.lower(b)

            end
        )

        for _, name in
            ipairs(names) do

            local data =
                Configs[name]

            local count = 0

            if type(data) == "table" then
                count = #data
            end

            local Button =
                Instance.new(
                    "TextButton"
                )

            Button.Parent =
                ConfigList

            if selectedConfig == name then

                Button.BackgroundColor3 =
                    Color3.fromRGB(
                        70,
                        70,
                        70
                    )

            else

                Button.BackgroundColor3 =
                    Color3.fromRGB(
                        25,
                        25,
                        25
                    )

            end

            Button.BorderColor3 =
                Color3.fromRGB(
                    80,
                    80,
                    80
                )

            Button.BorderSizePixel = 1

            Button.Size =
                UDim2.new(
                    0.95,
                    0,
                    0,
                    30
                )

            Button.Font =
                Enum.Font.GothamSemibold

            Button.Text =
                name ..
                " [" ..
                tostring(count) ..
                " frames]"

            Button.TextColor3 =
                Color3.fromRGB(
                    255,
                    255,
                    255
                )

            Button.TextSize = 11

            Button.MouseButton1Click:Connect(
                function()

                    selectedConfig =
                        name

                    refreshConfigList()

                    Status.Text =
                        "STATUS: SELECTED [" ..
                        name ..
                        "]"

                end
            )

        end

    end

