local RecordBtn

RecordBtn =
    CreateButton(
        "RECORD PATH: OFF",
        function(button)

            if playing then

                Status.Text =
                    "STATUS: STOP PLAYBACK FIRST"

                return
            end

            if recording then

                recording = false

                if recordConnection then

                    recordConnection:Disconnect()

                    recordConnection = nil

                end

                button.Text =
                    "RECORD PATH: OFF"

                Status.Text =
                    "STATUS: RECORD SAVED (" ..
                    tostring(
                        #frames
                    ) ..
                    " FRAMES)"

                return
            end

            frames = {}

            recording = true

            lastGrounded = true
            lastVerticalVelocity = 0
            jumpCooldown = 0
            jumpQueued = false

            button.Text =
                "RECORD PATH: ON"

            Status.Text =
                "STATUS: RECORDING..."

            local elapsed = 0
            local recordTime = 0

            --========================================--
            -- JUMP EVENT
            --========================================--

            local character,
                humanoid =
                getCharacter()

            if humanoid then

                humanoid.StateChanged:Connect(
                    function(
                        oldState,
                        newState
                    )

                        if not recording then
                            return
                        end

                        if newState ==
                            Enum.HumanoidStateType.Jumping then

                            jumpQueued = true

                        end

                    end
                )

            end

            --========================================--
            -- HEARTBEAT
            --========================================--

            recordConnection =
                RunService.Heartbeat:Connect(
                    function(dt)

                        if not recording then
                            return
                        end

                        recordTime += dt
                        elapsed += dt

                        local character,
                            humanoid,
                            root =
                            getCharacter()

                        if not character
                            or not humanoid
                            or not root then

                            return
                        end

                        --================================--
                        -- JUMP DETECTION
                        --================================--

                        local grounded =
                            humanoid.FloorMaterial
                            ~= Enum.Material.Air

                        local velocityY =
                            root.AssemblyLinearVelocity.Y

                        local state =
                            humanoid:GetState()

                        local jumpDetected =
                            false

                        if jumpQueued then

                            jumpDetected =
                                true

                            jumpQueued =
                                false

                            jumpCooldown =
                                0.20

                        end

                        if jumpCooldown > 0 then

                            jumpCooldown -= dt

                        end

                        -- Humanoid jumping state
                        if state ==
                            Enum.HumanoidStateType.Jumping then

                            if jumpCooldown <= 0 then

                                jumpDetected =
                                    true

                                jumpCooldown =
                                    0.20

                            end

                        end

                        -- Ground -> Air
                        if lastGrounded
                            and not grounded
                            and velocityY > 1 then

                            if jumpCooldown <= 0 then

                                jumpDetected =
                                    true

                                jumpCooldown =
                                    0.20

                            end

                        end

                        lastGrounded =
                            grounded

                        lastVerticalVelocity =
                            velocityY

                        --================================--
                        -- RECORD
                        --================================--

                        if elapsed >= RECORD_RATE
                            or jumpDetected then

                            elapsed = 0

                            table.insert(
                                frames,
                                {

                                    position =
                                        root.Position,

                                    jump =
                                        jumpDetected,

                                    time =
                                        recordTime

                                }
                            )

                        end

                    end
                )

        end
    )

