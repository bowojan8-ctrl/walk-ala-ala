local function getCharacter()

    local character =
        Player.Character

    if not character then
        return nil, nil, nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    return character, humanoid, root
end

--==================================================--
-- BASECAMP
--==================================================--

local function getResetRemote()

    local Remotes =
        ReplicatedStorage:FindFirstChild(
            "Remotes"
        )

    if not Remotes then

        warn(
            "BALJITOT: Remotes tidak ditemukan"
        )

        return nil
    end

    local ResetToBasecamp =
        Remotes:FindFirstChild(
            "ResetToBasecamp"
        )

    if not ResetToBasecamp then

        warn(
            "BALJITOT: ResetToBasecamp tidak ditemukan"
        )

        return nil
    end

    if not ResetToBasecamp:IsA(
        "RemoteEvent"
    ) then

        return nil
    end

    return ResetToBasecamp
end

local function resetToBasecamp()

    local remote =
        getResetRemote()

    if not remote then
        return false
    end

    local success =
        pcall(function()

            remote:FireServer()

        end)

    return success
end

