--==================================================--
-- MERGE CONFIGS
--==================================================--

local function mergeConfigs()

    if #MergeQueue < 1 then

        Status.Text =
            "STATUS: MERGE QUEUE EMPTY"

        return nil
    end

    local merged = {}

    local totalTime = 0

    for _, configName in
        ipairs(MergeQueue) do

        local config =
            Configs[configName]

        if config then

            local firstTime = nil
            local lastTime = 0

            for _, rawFrame in
                ipairs(config) do

                local frame =
                    normalizeFrame(
                        rawFrame
                    )

                if frame then

                    if firstTime == nil then
                        firstTime =
                            frame.time
                    end

                    lastTime =
                        frame.time

                    table.insert(
                        merged,
                        {

                            position =
                                frame.position,

                            jump =
                                frame.jump,

                            time =
                                totalTime +
                                math.max(
                                    0,
                                    frame.time -
                                    (firstTime or 0)
                                )

                        }
                    )

                end

            end

            if firstTime ~= nil then

                totalTime +=
                    math.max(
                        0,
                        lastTime -
                        firstTime
                    )

            end

        end

    end

    return merged
end

