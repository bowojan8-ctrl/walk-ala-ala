--==================================================--
-- FIND FRAME BY TIME
--==================================================--

local function getFrameAtTime(
    playbackTime,
    currentIndex
)

    local total =
        #frames

    if total == 0 then
        return nil, currentIndex
    end

    local index =
        currentIndex

    local skipped =
        0

    while index < total
        and frames[index + 1]
        and frames[index + 1].time
            <= playbackTime + TIME_LOOKAHEAD do

        index += 1

        skipped += 1

        if skipped >= MAX_FRAME_SKIP then
            break
        end

    end

    local current =
        frames[index]

    local nextFrame =
        frames[
            math.min(
                index + 1,
                total
            )
        ]

    return current,
        index,
        nextFrame

end

--==================================================--
-- PLAY PATH
--==================================================--

local function playPath()

    if #frames < 2 then

        Status.Text =
            "STATUS: LOAD / RECORD PATH FIRST"

        return
    end

    if playing then
        return
    end

    playing = true

    playToken += 1

    local currentToken =
        playToken

    Status.Text =
        "STATUS: PLAYING..."

    local _,
        humanoid,
        root =
        getCharacter()

    if not humanoid
        or not root then

        playing = false

        return
    end

    humanoid.AutoRotate =
        true

    -- Pastikan waktu dimulai dari 0.
    local firstTime =
        frames[1].time or 0

    local playbackTime = 0

    local currentIndex = 1

    local lastJumpTime = -999

    local previousFrameTime =
        frames[1].time or 0

    --==============================================--
    -- PLAYBACK LOOP
    --==============================================--

    playConnection =
        RunService.RenderStepped:Connect(
            function(dt)

                if not playing
                    or currentToken ~= playToken then

                    if playConnection then

                        playConnection:Disconnect()

                        playConnection = nil

                    end

                    stopMovement()

                    return

                end

                local character,
                    currentHumanoid,
                    currentRoot =
                    getCharacter()

                if not character
                    or not currentHumanoid
                    or not currentRoot then

                    playing = false

                    if playConnection then

                        playConnection:Disconnect()

                        playConnection = nil

                    end

                    return

                end

                --====================================--
                -- REAL TIME
                --====================================--

                playbackTime += dt

                --====================================--
                -- END
                --====================================--

                local lastFrame =
                    frames[#frames]

                local lastTime =
                    lastFrame.time or 0

                if playbackTime >= lastTime then

                    -- Jalankan posisi terakhir sebentar
                    -- lalu selesai.

                    local finalPosition =
                        lastFrame.position

                    local currentPosition =
                        currentRoot.Position

                    local difference =
                        Vector3.new(
                            finalPosition.X,
                            currentPosition.Y,
                            finalPosition.Z
                        )
                        -
                        currentPosition

                    if difference.Magnitude
                        > WAYPOINT_DISTANCE then

                        currentHumanoid:Move(
                            difference.Unit,
                            false
                        )

                    else

                        currentHumanoid:Move(
                            Vector3.zero,
                            false
                        )

                        playing = false

                        if playConnection then

                            playConnection:Disconnect()

                            playConnection = nil

                        end

                        stopMovement()

                        Status.Text =
                            "STATUS: PATH COMPLETE"

                        return

                    end

                end

                --====================================--
                -- FRAME
                --====================================--

                local frame,
                    index,
                    nextFrame =
                    getFrameAtTime(
                        playbackTime +
                        firstTime,
                        currentIndex
                    )

                if not frame then
                    return
                end

                currentIndex =
                    index

                --====================================--
                -- JUMP EVENT
                --====================================--

                if frame.jump then

                    local now =
                        os.clock()

                    if now -
                        lastJumpTime
                        > 0.18 then

                        if currentHumanoid.FloorMaterial
                            ~= Enum.Material.Air then

                            currentHumanoid.Jump =
                                true

                            lastJumpTime =
                                now

                        end

                    end

                end

                --====================================--
                -- TARGET POSITION
                --====================================--

                local target =
                    frame.position

                local targetPosition =
                    Vector3.new(
                        target.X,
                        currentRoot.Position.Y,
                        target.Z
                    )

                --====================================--
                -- INTERPOLATION
                --====================================--

                if nextFrame
                    and nextFrame ~= frame then

                    local t1 =
                        frame.time or 0

                    local t2 =
                        nextFrame.time or
                        t1 + RECORD_RATE

                    local duration =
                        math.max(
                            t2 - t1,
                            0.001
                        )

                    local localTime =
                        (
                            playbackTime +
                            firstTime -
                            t1
                        )

                    local alpha =
                        math.clamp(
                            localTime /
                            duration,
                            0,
                            1
                        )

                    local interpolated =
                        frame.position:Lerp(
                            nextFrame.position,
                            alpha
                        )

                    targetPosition =
                        Vector3.new(
                            interpolated.X,
                            currentRoot.Position.Y,
                            interpolated.Z
                        )

                end

                --====================================--
                -- MOVEMENT
                --====================================--

                local difference =
                    targetPosition -
                    currentRoot.Position

                local distance =
                    difference.Magnitude

                if distance > 0.05 then

                    local direction =
                        difference.Unit

                    currentHumanoid:Move(
                        direction,
                        false
                    )

                else

                    -- Jangan langsung lompat ke frame jauh.
                    -- Tetap Move zero agar frame diam ikut
                    -- direkam dan dimainkan.

                    currentHumanoid:Move(
                        Vector3.zero,
                        false
                    )

                end

                previousFrameTime =
                    frame.time or
                    previousFrameTime

            end
        )

end

